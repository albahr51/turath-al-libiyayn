---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="البحث في كامل المحتوى" description="البحث في كامل أعمال الشيخين أبي يحيى وعطية الله الليبيين">
  <Header />

  <main class="search-page">
    <div class="search-page-inner">
      <h1 class="search-page-title">البحث في كامل المحتوى</h1>

      <form id="search-page-form" class="search-page-form" role="search">
        <div class="search-page-input-wrap">
          <svg class="search-page-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" id="search-page-input" name="q" class="search-page-input" placeholder="اكتب كلمة أو عبارة... مثل: حزب الله، الجهاد، الحكم بما أنزل الله" autocomplete="off" autofocus />
          <button type="submit" class="search-page-submit">بحث</button>
        </div>
        <div class="search-page-hint">علامة التنصيص "..." للبحث عن عبارة حرفية، بدونها تُطبَّق قواعد الربط المنطقي (جميع الكلمات أولًا ثم الأقرب).</div>
      </form>

      <div id="search-page-results" class="search-page-results">
        <div class="search-page-status">اكتب كلمة أو عبارة للبحث...</div>
      </div>
    </div>
  </main>

  <Footer />
</Layout>

<script>
  import { normArabic, stemWord, buildHighlightRegex } from '../scripts/search-common.mjs';

  const authorLabels = {
    'abu-yahya': 'مجموع أعمال الشيخ أبي يحيى الليبي',
    'atiyatullah': 'مجموع أعمال الشيخ عطية الله الليبي'
  };

  let metaPromise = null;
  let textPromise = null;
  let dict: string[] = [];
  let dictMap: Map<string, number> = new Map();
  let highlightRe: RegExp | null = null;
  let currentQuery = '';
  let seq = 0;

  const input = document.getElementById('search-page-input') as HTMLInputElement;
  const form = document.getElementById('search-page-form') as HTMLFormElement;
  const box = document.getElementById('search-page-results') as HTMLElement;

  function loadMeta(): Promise<any> {
    if (!metaPromise) metaPromise = fetch('/search/search-meta.json').then((r) => r.json());
    return metaPromise;
  }

  function loadText(): Promise<string[]> {
    if (!textPromise) textPromise = fetch('/search/search-text.json').then((r) => r.json());
    return textPromise;
  }

  loadMeta();
  loadText();

  function escapeHtml(s: string): string {
    return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }

  function buildQuery(q: string) {
    const phrases: string[] = [];
    let rest = q;
    const re = /"([^"]+)"/g;
    let m: RegExpExecArray | null;
    while ((m = re.exec(q)) !== null) {
      const p = normArabic(m[1].replace(/["«»]/g, '').trim());
      if (p.length >= 2) phrases.push(p);
      rest = rest.replace(m[0], ' ');
    }
    const words: { raw: string; stem: string }[] = [];
    const seen = new Set<string>();
    for (const w of normArabic(rest).split(/\s+/).filter((w) => w.length >= 2)) {
      const raw = w;
      const stem = stemWord(w);
      if (!seen.has(stem)) {
        seen.add(stem);
        words.push({ raw, stem });
      }
    }
    const phraseWords: { raw: string; stem: string }[] = [];
    for (const p of phrases) {
      for (const w of normArabic(p).split(/\s+/).filter((w) => w.length >= 2)) {
        const raw = w;
        const stem = stemWord(w);
        if (!seen.has(stem)) {
          seen.add(stem);
          phraseWords.push({ raw, stem });
        }
      }
    }
    const phraseFull = normArabic(q.replace(/["«»]/g, '')).replace(/\s+/g, ' ').trim();
    return { phrases, words, phraseWords, phraseFull };
  }

  function countOcc(t: string, s: string): number {
    if (!s) return 0;
    let c = 0;
    let i = 0;
    while ((i = t.indexOf(s, i)) !== -1) {
      c++;
      i += s.length;
    }
    return c;
  }

  function wordMatch(doc: any, word: { stem: string }): number {
    const idx = dictMap.get(word.stem);
    if (idx !== undefined && doc.w.indexOf(idx) !== -1) return 2;
    if (word.stem.length >= 4) {
      for (const i of doc.w) {
        const dw = dict[i];
        if (dw.length >= 4 && dw.indexOf(word.stem) !== -1) return 1;
      }
    }
    return 0;
  }

  function minSpan(t: string, words: string[]): number {
    const lists: number[][] = [];
    for (const w of words) {
      const out: number[] = [];
      let from = 0;
      while (out.length < 6) {
        const i = t.indexOf(w, from);
        if (i === -1) break;
        out.push(i);
        from = i + 1;
      }
      if (!out.length) return Infinity;
      lists.push(out);
    }
    if (lists.length > 4) {
      let lo = Infinity;
      let hi = -Infinity;
      for (const l of lists) {
        if (l[0] < lo) lo = l[0];
        if (l[0] > hi) hi = l[0];
      }
      return hi - lo;
    }
    let best = Infinity;
    function rec(k: number, curMin: number, curMax: number) {
      if (curMax - curMin >= best) return;
      if (k === lists.length) { best = curMax - curMin; return; }
      for (const p of lists[k]) rec(k + 1, Math.min(curMin, p), Math.max(curMax, p));
    }
    rec(0, Infinity, -Infinity);
    return best;
  }

  function metaScore(doc: any, query: any) {
    const strong: { raw: string; stem: string }[] = [];
    let hasPartial = false;
    const words = query.words.length ? query.words : query.phraseWords;
    for (const w of words) {
      const m = wordMatch(doc, w);
      if (m >= 2) strong.push(w);
      else if (m === 1) hasPartial = true;
    }
    return { strong, hasPartial };
  }

  function fullScore(r: any, query: any) {
    const t = r.doc.t;
    let phraseHit = 0;
    if (query.phraseFull.length >= 3 && countOcc(t, query.phraseFull) > 0) phraseHit = 1;
    if (!phraseHit) {
      for (const ph of query.phrases) {
        if (countOcc(t, ph) > 0) { phraseHit = 1; break; }
      }
    }
    let span = 0;
    if (r.s.strong.length >= 2) {
      const s = minSpan(t, r.s.strong.map((w: any) => w.raw));
      if (s <= 600) span = 600 - s;
    }
    let occ = 0;
    for (const w of r.s.strong) occ += Math.min(countOcc(t, w.raw), 50);
    r.s.phraseHit = phraseHit;
    r.s.span = span;
    r.s.occ = occ;
    r.ctx = extractContext(r.doc, query);
  }

  function extractContext(doc: any, query: any) {
    const t = doc.t || '';
    let idx = -1;
    if (query.phraseFull.length >= 3) idx = t.indexOf(query.phraseFull);
    if (idx === -1) {
      for (const w of [...query.words, ...query.phraseWords]) {
        idx = t.indexOf(w.raw);
        if (idx !== -1) break;
      }
    }
    if (idx === -1) idx = 0;
    const start = Math.max(0, idx - 130);
    const end = Math.min(t.length, idx + 240);
    return { text: t.slice(start, end), start };
  }

  function highlightText(text: string): string {
    const esc = escapeHtml(text);
    if (!highlightRe) return esc;
    return esc.replace(highlightRe, '<mark>$1</mark>');
  }

  function splitLines(plain: string): string {
    const total = plain.length;
    if (!total) return '';
    const size = Math.ceil(total / 3);
    const lines: string[] = [];
    let start = 0;
    while (start < total && lines.length < 3) {
      let end = Math.min(total, start + size);
      if (end < total) {
        const sp = plain.lastIndexOf(' ', end);
        if (sp > start) end = sp + 1;
      }
      lines.push(plain.slice(start, end).trim());
      start = end;
    }
    return lines.map((l) => highlightText(l)).join('<br class="search-result-br" />');
  }

  function pageLabel(o: number): string {
    return o > 0 ? `<span class="search-result-page">صفحة ${o}</span>` : '';
  }

  function resultHtml(r: any): string {
    const book = authorLabels[r.doc.au] || '';
    const url = `/book/${r.doc.au}/${r.doc.sl}#q=${encodeURIComponent(currentQuery)}`;
    const body = r.ctx
      ? `<div class="search-result-text">${splitLines(r.ctx.text)}</div>`
      : `<div class="search-result-text search-result-loading">جارٍ تحميل نص الصفحة...</div>`;
    return `<a class="search-result" href="${url}">
      <div class="search-result-top">
        <span class="search-result-book">${book}</span>
        ${pageLabel(r.doc.o)}
      </div>
      ${body}
      <div class="search-result-open">افتح في الكتاب ←</div>
    </a>`;
  }

  function renderResults(q: string, strong: any[], partial: any[], pendingText: boolean) {
    if (!strong.length && !partial.length) {
      box.innerHTML = `<div class="search-page-status">لا توجد نتائج لـ "${escapeHtml(q)}".</div>`;
      return;
    }
    const shown = strong.length || partial.length;
    let html = `<div class="search-page-count">${shown} نتيجة عن "${escapeHtml(q)}"${pendingText ? ' <span class="search-page-pending">— جارٍ تحميل النصوص لاستكمال المقتطفات وتحسين الترتيب...</span>' : ''}</div>`;
    if (strong.length) {
      html += strong.slice(0, 100).map(resultHtml).join('');
      if (strong.length > 100) {
        html += `<div class="search-page-more">يعرض أول 100 من أصل ${strong.length} نتيجة...</div>`;
      }
    }
    if (!strong.length && partial.length) {
      html += `<div class="search-page-note">لم يُعثر على نتائج تطابق الكلمات معًا. إليك أقرب النتائج:</div>`;
      html += partial.slice(0, 30).map(resultHtml).join('');
      if (partial.length > 30) {
        html += `<div class="search-page-more">يعرض أول 30 من أصل ${partial.length} نتيجة...</div>`;
      }
    }
    const scrollY = window.scrollY;
    box.innerHTML = html;
    window.scrollTo(0, scrollY);
  }

  async function runSearch(q: string) {
    const mySeq = ++seq;
    currentQuery = q.trim();
    if (!currentQuery) {
      box.innerHTML = '<div class="search-page-status">اكتب كلمة أو عبارة للبحث...</div>';
      return;
    }
    box.innerHTML = '<div class="search-page-status">جارٍ البحث...</div>';

    let meta: any;
    try {
      meta = await loadMeta();
    } catch (e) {
      box.innerHTML = '<div class="search-page-status">تعذّر تحميل فهرس البحث.</div>';
      return;
    }
    if (mySeq !== seq) return;

    dict = meta.d;
    dictMap = new Map(dict.map((s: string, i: number) => [s, i]));

    const query = buildQuery(currentQuery);
    if (!query.phrases.length && !query.words.length && !query.phraseWords.length) {
      box.innerHTML = `<div class="search-page-status">لا توجد كلمات كافية للبحث عن "${escapeHtml(currentQuery)}".</div>`;
      return;
    }

    highlightRe = buildHighlightRegex(
      query.words.length ? query.words.map((w: any) => w.raw) : [query.phraseFull]
    );

    const strong: any[] = [];
    const partial: any[] = [];
    for (const doc of meta.docs) {
      const s = metaScore(doc, query);
      if (s.strong.length) strong.push({ doc, s, ctx: null });
      else if (s.hasPartial) partial.push({ doc, s, ctx: null });
    }
    const sortMeta = (a: any, b: any) =>
      (a.doc.o || 999999) - (b.doc.o || 999999);
    strong.sort(sortMeta);
    partial.sort(sortMeta);

    renderResults(currentQuery, strong, partial, true);

    const shown = strong.length ? strong : partial;
    if (!shown.length) return;

    loadText()
      .then((texts) => {
        if (mySeq !== seq) return;
        for (const r of shown) {
          r.doc.t = texts[r.doc.id - 1] || '';
          fullScore(r, query);
        }
        shown.sort((a, b) => {
          if (b.s.phraseHit !== a.s.phraseHit) return b.s.phraseHit - a.s.phraseHit;
          if (b.s.strong.length !== a.s.strong.length) return b.s.strong.length - a.s.strong.length;
          if (b.s.span !== a.s.span) return b.s.span - a.s.span;
          if (b.s.occ !== a.s.occ) return b.s.occ - a.s.occ;
          return (a.doc.o || 999999) - (b.doc.o || 999999);
        });
        renderResults(currentQuery, strong, partial, false);
      })
      .catch(() => {
        if (mySeq !== seq) return;
        renderResults(currentQuery, strong, partial, false);
      });
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = input.value.trim();
    const url = q ? '/search?q=' + encodeURIComponent(q) : '/search';
    window.history.pushState({ q }, '', url);
    runSearch(q);
  });

  window.addEventListener('popstate', () => {
    const q = new URLSearchParams(window.location.search).get('q') || '';
    input.value = q;
    runSearch(q);
  });

  const initial = new URLSearchParams(window.location.search).get('q') || '';
  input.value = initial;
  runSearch(initial);
</script>

<style>
  .search-page {
    min-height: 70vh;
    padding: 48px 20px 72px;
    background: var(--bg-color);
  }
  .search-page-inner {
    max-width: 780px;
    margin: 0 auto;
  }
  .search-page-title {
    font-family: var(--font-serif), serif;
    font-size: 1.9rem;
    text-align: center;
    color: var(--primary-color);
    margin-bottom: 24px;
  }
  .search-page-form {
    margin-bottom: 28px;
  }
  .search-page-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--card-bg);
    border: 1.5px solid var(--border-color);
    border-radius: 12px;
    padding: 8px 14px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .search-page-input-wrap:focus-within {
    border-color: var(--primary-light);
    box-shadow: 0 0 0 3px var(--shadow-color);
  }
  .search-page-icon {
    color: var(--text-muted);
    flex-shrink: 0;
  }
  .search-page-input {
    flex: 1;
    border: none;
    outline: none;
    background: transparent;
    font-size: 1.05rem;
    font-family: var(--font-sans), sans-serif;
    color: var(--text-color);
    min-width: 0;
  }
  .search-page-submit {
    border: none;
    border-radius: 8px;
    padding: 8px 22px;
    background: var(--primary-color);
    color: #fff;
    font-family: var(--font-sans), sans-serif;
    font-size: 0.95rem;
    cursor: pointer;
    transition: background var(--transition-fast);
  }
  .search-page-submit:hover {
    background: var(--primary-light);
  }
  .search-page-hint {
    margin-top: 10px;
    font-size: 0.82rem;
    color: var(--text-muted);
    text-align: center;
  }
  .search-page-results {
    margin-top: 8px;
  }
  .search-page-status {
    text-align: center;
    color: var(--text-muted);
    padding: 40px 0;
  }
  .search-page-count {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin-bottom: 18px;
    padding-inline-start: 4px;
  }
  .search-page-pending {
    color: var(--accent-color);
  }
  .search-page-note {
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 10px;
    padding: 12px 16px;
    margin: 18px 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }
  .search-page-more {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.85rem;
    padding: 10px 0;
  }
  .search-result {
    display: block;
    text-decoration: none;
    color: inherit;
    background: var(--card-bg);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 16px 18px;
    margin-bottom: 14px;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }
  .search-result:hover {
    border-color: var(--primary-light);
    box-shadow: 0 4px 14px var(--shadow-color);
  }
  .search-result-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 10px;
  }
  .search-result-book {
    font-family: var(--font-serif), serif;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--primary-color);
  }
  .search-result-page {
    flex-shrink: 0;
    font-size: 0.82rem;
    color: var(--text-muted);
    background: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 999px;
    padding: 3px 12px;
  }
  .search-result-text {
    font-family: var(--font-serif), serif;
    font-size: 0.95rem;
    line-height: 1.9;
    color: var(--text-muted);
  }
  .search-result-text mark {
    background: #ffdd57;
    color: #1f2421;
    outline: 3px solid #e6a800;
    border-radius: 4px;
    padding: 0 2px;
  }
  [data-theme="dark"] .search-result-text mark {
    background: #b78a2f;
    color: #0b100d;
    outline: 3px solid #8a641f;
  }
  .search-result-loading {
    color: var(--text-muted);
    font-style: italic;
    opacity: 0.75;
  }
  .search-result-open {
    margin-top: 12px;
    padding-top: 10px;
    border-top: 1px dashed var(--border-color);
    font-size: 0.85rem;
    color: var(--accent-color);
    font-weight: 600;
  }
  .search-result:hover .search-result-open {
    text-decoration: underline;
  }
</style>
