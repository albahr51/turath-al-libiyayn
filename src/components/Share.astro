---
interface Props {
  /** Text/title to share. Defaults to the document title. */
  title?: string;
  /** Custom URL to share. Defaults to window.location.href. */
  url?: string;
}

const { title, url } = Astro.props;
---

<div class="share-root" data-share-root data-share-title={title || ''} data-share-url={url || ''}>
  <button type="button" class="share-open-btn" data-share-open aria-label="مشاركة">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="18" cy="5" r="3"></circle>
      <circle cx="6" cy="12" r="3"></circle>
      <circle cx="18" cy="19" r="3"></circle>
      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line>
      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line>
    </svg>
    <span>مشاركة</span>
  </button>
  <span class="share-modal-overlay" data-share-overlay hidden></span>
  <div class="share-modal" data-share-modal hidden role="dialog" aria-modal="true" aria-label="مشاركة الصفحة">
    <div class="share-modal-head">
      <h3 class="share-modal-title">مشاركة هذه الصفحة</h3>
      <button type="button" class="share-modal-close" data-share-close aria-label="إغلاق">&times;</button>
    </div>
    <div class="share-modal-body">
      <div class="share-link-row">
        <input type="text" class="share-link-input" data-share-link readonly value="" />
        <button type="button" class="share-copy-btn" data-share-copy>نسخ الرابط</button>
      </div>
      <span class="share-copy-toast" data-share-toast role="status">تم نسخ الرابط</span>
      <div class="share-networks">
        <a class="share-network share-whatsapp" data-share-net href="#" target="_blank" rel="noopener" data-share-whatsapp>
          <span class="share-net-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347l-.004.001zM12.02 21.5h-.004a9.54 9.54 0 01-4.864-1.332l-.349-.207-3.616.947.965-3.524-.228-.362a9.55 9.55 0 01-1.421-5.083c0-5.264 4.286-9.55 9.559-9.55 2.553 0 4.953.996 6.758 2.802a9.496 9.496 0 012.804 6.759c0 5.263-4.286 9.549-9.55 9.549l-.053-.001zm8.232-17.732A10.997 10.997 0 0012.02.5C5.395.5.06 5.835.06 12.46c0 2.107.55 4.164 1.597 5.977L.06 23.5l5.202-1.364a11.865 11.865 0 005.708 1.455h.005c6.625 0 11.96-5.335 11.96-11.96 0-3.195-1.244-6.2-3.503-8.46z"/></svg>
          </span>
          <span>واتساب</span>
        </a>
        <a class="share-network share-telegram" data-share-net href="#" target="_blank" rel="noopener" data-share-telegram>
          <span class="share-net-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11.944 0A12 12 0 000 12a12 12 0 0012 12 12 12 0 0012-12A12 12 0 0012 0a12 12 0 00-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 01.171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </span>
          <span>تلجرام</span>
        </a>
        <a class="share-network share-x" data-share-net href="#" target="_blank" rel="noopener" data-share-x>
          <span class="share-net-icon">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </span>
          <span>إكس</span>
        </a>
        <a class="share-network share-facebook" data-share-net href="#" target="_blank" rel="noopener" data-share-facebook>
          <span class="share-net-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073C24 5.405 18.627 0 12 0S0 5.405 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047v-2.66c0-3.026 1.792-4.697 4.533-4.697 1.313 0 2.686.236 2.686.236v2.971H15.83c-1.491 0-1.955.93-1.955 1.886v2.264h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/></svg>
          </span>
          <span>فيسبوك</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  const root = document.querySelector('[data-share-root]');
  if (root) {
    const openBtn = root.querySelector('[data-share-open]');
    const overlay = root.querySelector('[data-share-overlay]');
    const modal = root.querySelector('[data-share-modal]');
    const closeBtn = root.querySelector('[data-share-close]');
    const linkInput = root.querySelector('[data-share-link]');
    const copyBtn = root.querySelector('[data-share-copy]');
    const toast = root.querySelector('[data-share-toast]');
    const title = root.getAttribute('data-share-title') || document.title;
    const url = root.getAttribute('data-share-url') || window.location.href;

    function openModal() {
      overlay.hidden = false;
      modal.hidden = false;
      linkInput.value = url;
      document.body.style.overflow = 'hidden';
    }
    function closeModal() {
      overlay.hidden = true;
      modal.hidden = true;
      document.body.style.overflow = '';
    }

    openBtn.addEventListener('click', async () => {
      const shareData = { title: title, url: url };
      if (typeof navigator.share === 'function') {
        try {
          await navigator.share(shareData);
          return;
        } catch (e) {
          if (e && e.name === 'AbortError') return;
        }
      }
      openModal();
    });

    closeBtn.addEventListener('click', closeModal);
    overlay.addEventListener('click', closeModal);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !modal.hidden) closeModal();
    });

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
      } catch (e) {
        linkInput.select();
        document.execCommand('copy');
      }
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2000);
    });

    const nets = {
      whatsapp: (u, t) => `https://api.whatsapp.com/send?text=${encodeURIComponent(t + '\n' + u)}`,
      telegram: (u, t) => `https://t.me/share/url?url=${encodeURIComponent(u)}&text=${encodeURIComponent(t)}`,
      x: (u, t) => `https://twitter.com/intent/tweet?url=${encodeURIComponent(u)}&text=${encodeURIComponent(t)}`,
      facebook: (u) => `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(u)}`
    };
    Object.keys(nets).forEach((key) => {
      const el = root.querySelector(`[data-share-${key}]`);
      if (el) el.href = nets[key](url, title);
    });
  }
</script>

<style is:global>
  .share-root {
    position: relative;
    display: inline-flex;
  }
  .share-open-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 8px;
    background-color: var(--card-bg);
    color: var(--primary-color);
    border: 1.5px solid var(--accent-color);
    font-family: var(--font-sans), sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
    transition: all var(--transition-fast);
  }
  .share-open-btn:hover {
    background-color: var(--accent-color);
    color: #fff;
    transform: translateY(-1px);
  }
  .share-modal-overlay {
    position: fixed;
    inset: 0;
    background-color: rgba(0, 0, 0, 0.5);
    z-index: 9990;
    backdrop-filter: blur(3px);
  }
  .share-modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: min(420px, calc(100vw - 32px));
    background-color: var(--bg-color);
    border: 1px solid var(--border-color);
    border-radius: 14px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
    z-index: 9991;
    overflow: hidden;
    direction: rtl;
  }
  .share-modal-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(180deg, rgba(181, 138, 56, 0.08), transparent);
  }
  .share-modal-title {
    font-family: var(--font-serif), serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--primary-color);
  }
  .share-modal-close {
    background: none;
    border: none;
    font-size: 1.6rem;
    line-height: 1;
    color: var(--text-muted);
    cursor: pointer;
    padding: 0 4px;
  }
  .share-modal-close:hover {
    color: var(--accent-color);
  }
  .share-modal-body {
    padding: 20px;
  }
  .share-link-row {
    display: flex;
    gap: 8px;
  }
  .share-link-input {
    flex: 1;
    padding: 10px 14px;
    border: 1px solid var(--border-color);
    border-radius: 8px;
    background: var(--card-bg);
    color: var(--text-color);
    font-family: var(--font-sans), sans-serif;
    font-size: 0.85rem;
    direction: ltr;
    text-align: left;
  }
  .share-copy-btn {
    padding: 10px 18px;
    border: none;
    border-radius: 8px;
    background-color: var(--primary-color);
    color: #fff;
    font-family: var(--font-sans), sans-serif;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
    transition: background var(--transition-fast);
    white-space: nowrap;
  }
  .share-copy-btn:hover {
    background-color: var(--primary-light);
  }
  .share-copy-toast {
    display: block;
    margin-top: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary-light);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }
  .share-copy-toast.show {
    opacity: 1;
  }
  .share-networks {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-top: 18px;
  }
  .share-network {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    border-radius: 10px;
    text-decoration: none;
    font-family: var(--font-sans), sans-serif;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
    transition: transform var(--transition-fast), opacity var(--transition-fast);
  }
  .share-network:hover {
    transform: translateY(-2px);
    opacity: 0.9;
  }
  .share-net-icon {
    display: inline-flex;
  }
  .share-whatsapp { background-color: #25D366; }
  .share-telegram { background-color: #229ED9; }
  .share-x { background-color: #111827; }
  .share-facebook { background-color: #1877F2; }
  @media (max-width: 380px) {
    .share-networks { grid-template-columns: 1fr; }
  }
</style>
